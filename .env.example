# LINE Bot credentials
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Stripe payment integration
# Get these from https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Stripe Price IDs (create in Stripe Dashboard)
# お試しプラン: ¥500 one-time payment
STRIPE_PRICE_TRIAL=price_your_trial_price_id_here
# ベーシックプラン: ¥980/month recurring
STRIPE_PRICE_BASIC=price_your_basic_price_id_here
# プレミアムプラン: ¥1,980/month recurring
STRIPE_PRICE_PREMIUM=price_your_premium_price_id_here

# Public URL of this app (used for Stripe redirect URLs)
APP_BASE_URL=https://your-app-url.onrender.com

# Database path (optional, defaults to tarot_history.db)
# DB_PATH=tarot_history.db
